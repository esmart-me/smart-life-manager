// Smart Life Manager - Relational Database Schema
// Engine: SQLite (Local) / Compatible with PostgreSQL for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. Users & Authentication
// -------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          String    @default("user") // "user" | "admin"
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 1-to-1 relations
  profile       Profile?
  settings      UserSetting?

  // 1-to-many user-owned modules
  documents     Document[]
  documentFiles DocumentFile[]
  reminders     Reminder[]
  payments      Payment[]
  expenses      Expense[]
  budgets       Budget[]
  vehicles      Vehicle[]
  subscriptions Subscription[]
  importantDates ImportantDate[]
  familyMembers FamilyMember[]
  notifications Notification[]
  sessions      Session[]
  passwordResetTokens PasswordResetToken[]
  userSubscription UserSubscription?
  ownedFamilyGroups FamilyGroup[]
  adminAuditLogs    AdminAuditLog[]
  billingTransactions BillingTransaction[]

  @@index([email])
}

// Session store for server-side revocation and security tracking
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// Secure token store for Forgot/Reset Password flows
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

// -------------------------------------------------------------
// 2. Profiles
// -------------------------------------------------------------
model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String?
  lastName    String?
  displayName String?
  avatarUrl   String?
  phoneNumber String?
  timezone    String   @default("UTC")
  country     String?  @default("US")
  region      String?  @default("US")
  currency    String   @default("USD")
  locale      String   @default("en-US")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -------------------------------------------------------------
// 3. User Settings
// -------------------------------------------------------------
model UserSetting {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme              String   @default("system") // "system" | "light" | "dark"
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  reminderDaysBefore Int      @default(3)
  weeklyDigest       Boolean  @default(true)
  securityAlerts     Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// -------------------------------------------------------------
// 4. Documents & Document Files (Prepared for Private Storage)
// -------------------------------------------------------------
model Document {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  category       String         // "identity" | "finance" | "vehicle" | "property" | "medical" | "other"
  documentNumber String?
  issuedBy       String?
  issueDate      DateTime?
  expiryDate     DateTime?
  hasExpiry      Boolean        @default(false)
  notes          String?
  tags           String?        // Comma-separated or JSON string
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  files          DocumentFile[]

  @@index([userId])
  @@index([category])
  @@index([expiryDate])
}

model DocumentFile {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  fileType      String   // MIME type
  fileSize      Int      // File size in bytes
  storageKey    String   // Encrypted storage key / object path
  storageDriver String   @default("local") // "local" | "s3" | "gcs"
  isEncrypted   Boolean  @default(true)
  checksum      String?
  createdAt     DateTime @default(now())

  @@index([documentId])
  @@index([userId])
}

// -------------------------------------------------------------
// 5. Reminders
// -------------------------------------------------------------
model Reminder {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  dueDate        DateTime
  priority       String    @default("medium") // "low" | "medium" | "high" | "urgent"
  status         String    @default("pending") // "pending" | "completed" | "snoozed" | "cancelled"
  category       String    @default("general") // "document" | "payment" | "vehicle" | "personal" | "general"
  relatedType    String?   // "document" | "payment" | "vehicle" | "subscription"
  relatedId      String?
  isRecurring    Boolean   @default(false)
  recurrenceRule String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([dueDate])
  @@index([status])
  @@index([priority])
}

// -------------------------------------------------------------
// 6. Payments
// -------------------------------------------------------------
model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  payee       String?
  amount      Float
  currency    String    @default("USD")
  dueDate     DateTime
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  category    String    @default("bill") // "bill" | "loan" | "tax" | "insurance" | "rent" | "other"
  isRecurring Boolean   @default(false)
  frequency   String?   // "weekly" | "monthly" | "quarterly" | "yearly"
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([dueDate])
  @@index([isPaid])
}

// -------------------------------------------------------------
// 7. Expenses
// -------------------------------------------------------------
model Expense {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  amount        Float
  currency      String   @default("USD")
  category      String   // "housing" | "transport" | "food" | "utilities" | "entertainment" | "health" | "other"
  spentAt       DateTime @default(now())
  paymentMethod String?  // "card" | "cash" | "transfer"
  merchant      String?
  notes         String?
  receiptUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([spentAt])
  @@index([category])
}

// -------------------------------------------------------------
// 8. Budgets
// -------------------------------------------------------------
model Budget {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       String
  limitAmount    Float
  currency       String    @default("USD")
  period         String    @default("monthly") // "monthly" | "weekly" | "yearly"
  startDate      DateTime?
  endDate        DateTime?
  alertThreshold Int       @default(80)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([category])
}

// -------------------------------------------------------------
// 9. Vehicles
// -------------------------------------------------------------
model Vehicle {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String    // e.g. "Primary Car"
  make               String?
  model              String?
  year               Int?
  licensePlate       String?
  vin                String?
  registrationExpiry DateTime?
  insuranceExpiry    DateTime?
  inspectionExpiry   DateTime?
  nextServiceDate    DateTime?
  mileage            Int?
  nextServiceMileage Int?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
}

// -------------------------------------------------------------
// 10. Subscriptions
// -------------------------------------------------------------
model Subscription {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  cost            Float
  currency        String   @default("USD")
  billingCycle    String   @default("monthly") // "monthly" | "yearly" | "weekly" | "quarterly"
  nextBillingDate DateTime
  renewalStatus   String   @default("active")  // "active" | "cancelled" | "paused"
  category        String   @default("entertainment")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([nextBillingDate])
  @@index([renewalStatus])
}

// -------------------------------------------------------------
// 11. Important Dates
// -------------------------------------------------------------
model ImportantDate {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  eventDate          DateTime
  category           String   @default("personal") // "anniversary" | "birthday" | "legal" | "health" | "career"
  recurrence         String   @default("yearly")   // "none" | "yearly" | "monthly"
  reminderDaysBefore Int      @default(7)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([eventDate])
}

// -------------------------------------------------------------
// 12. Family Members
// -------------------------------------------------------------
model FamilyMember {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  relationship     String    // "spouse" | "child" | "parent" | "sibling" | "other"
  birthDate        DateTime?
  bloodType        String?
  emergencyContact Boolean   @default(false)
  phoneNumber      String?
  email            String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
}

// -------------------------------------------------------------
// 13. Notifications
// -------------------------------------------------------------
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("info") // "info" | "warning" | "alert" | "success"
  isRead    Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

// -------------------------------------------------------------
// 14. Subscription Tiers & Billing Architecture
// -------------------------------------------------------------
model UserSubscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               String    @default("free") // "free" | "premium" | "family"
  status             String    @default("active") // "active" | "past_due" | "cancelled" | "trialing"
  billingInterval    String    @default("monthly") // "monthly" | "yearly"
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  trialEndsAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([plan])
}

// Configurable Plan Catalog (Admin-modifiable without code deployments)
model PlanConfig {
  id                        String   @id @default(cuid())
  plan                      String   @unique // "free" | "premium" | "family"
  name                      String
  description               String?
  monthlyPrice              Float    @default(0.0)
  yearlyPrice               Float    @default(0.0)
  currency                  String   @default("USD")
  maxDocuments              Int      @default(5) // -1 for unlimited
  maxVehicles               Int      @default(1) // -1 for unlimited
  maxFamilyMembers          Int      @default(0) // e.g. 6 for family plan
  allowAdvancedReports      Boolean  @default(false)
  allowExports              Boolean  @default(false)
  allowSubscriptionTracking Boolean  @default(false)
  allowCloudBackup          Boolean  @default(false)
  allowCustomRecurrence     Boolean  @default(false)
  allowAiAssistant          Boolean  @default(false)
  allowMultiDeviceSync      Boolean  @default(false)
  isPopular                 Boolean  @default(false)
  isActive                  Boolean  @default(true)
  updatedAt                 DateTime @updatedAt

  @@index([plan])
}

// -------------------------------------------------------------
// 15. Family Group & Permission Sharing
// -------------------------------------------------------------
model FamilyGroup {
  id        String              @id @default(cuid())
  name      String
  ownerId   String
  owner     User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members   FamilyGroupMember[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([ownerId])
}

model FamilyGroupMember {
  id               String      @id @default(cuid())
  familyGroupId    String
  familyGroup      FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  userId           String?     // Linked user ID if member has an account
  name             String
  email            String?
  role             String      @default("Member") // "Owner" | "Admin" | "Member" | "View Only"
  canViewDocuments Boolean     @default(true)
  canEditDocuments Boolean     @default(false)
  canViewFinance   Boolean     @default(false)
  canEditFinance   Boolean     @default(false)
  canViewVehicles  Boolean     @default(true)
  canEditVehicles  Boolean     @default(false)
  status           String      @default("active") // "active" | "invited" | "pending"
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([familyGroupId])
  @@index([userId])
}

// -------------------------------------------------------------
// 16. Regional Pricing Catalog
// -------------------------------------------------------------
model PlanRegionalPricing {
  id             String   @id @default(cuid())
  plan           String   // "free" | "premium" | "family"
  regionCode     String   // "IN" | "AE" | "US" | "GB" | "EU" | "SA" | "QA" | "KW" | "OM" | "BH"
  country        String
  currency       String
  currencySymbol String
  monthlyPrice   Float    @default(0.0)
  yearlyPrice    Float    @default(0.0)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([plan, regionCode])
  @@index([regionCode])
  @@index([plan])
}

// -------------------------------------------------------------
// 17. Billing & Payment Transactions (Subscription Ledger)
// -------------------------------------------------------------
model BillingTransaction {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            String   // "free" | "premium" | "family"
  amount          Float
  currency        String   @default("USD")
  status          String   @default("paid") // "paid" | "failed" | "pending" | "refunded" | "cancelled"
  paymentProvider String   @default("sandbox") // "stripe_test" | "paypal_test" | "sandbox" | "manual"
  transactionId   String   @unique
  billingCycle    String   @default("monthly") // "monthly" | "yearly"
  paymentDate     DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([transactionId])
  @@index([paymentDate])
}

// -------------------------------------------------------------
// 18. Admin Audit Log (Security & Activity Trail)
// -------------------------------------------------------------
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminEmail String
  action     String   // "admin_login" | "plan_price_change" | "plan_toggled" | "customer_data_cleared" | "subscription_override" | "role_change"
  targetType String?  // "plan" | "user" | "subscription" | "payment" | "system"
  targetId   String?
  details    String?  // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

