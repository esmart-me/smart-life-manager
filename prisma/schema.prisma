// Smart Life Manager - Relational Database Schema
// Engine: SQLite (Local) / Compatible with PostgreSQL for production

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// 1. Users & Authentication
// -------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  role          String    @default("user") // "user" | "admin"
  status        String    @default("active") // "active" | "inactive" | "suspended" | "archived" | "deleted"
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // 1-to-1 relations
  profile       Profile?
  settings      UserSetting?

  // 1-to-many user-owned modules
  documents     Document[]
  documentFiles DocumentFile[]
  reminders     Reminder[]
  payments      Payment[]
  expenses      Expense[]
  budgets       Budget[]
  vehicles      Vehicle[]
  subscriptions Subscription[]
  importantDates ImportantDate[]
  familyMembers FamilyMember[]
  notifications Notification[]
  sessions      Session[]
  passwordResetTokens PasswordResetToken[]
  userSubscription UserSubscription?
  ownedFamilyGroups FamilyGroup[]
  adminAuditLogs    AdminAuditLog[]
  billingTransactions BillingTransaction[]
  aiConversations   AiConversation[]
  pushSubscriptions PushSubscription[]
  creditCards       CreditCard[]
  creditCardEmis    CreditCardEmi[]
  investments       Investment[]
  healthProfiles    HealthProfile[]
  healthInsurances  HealthInsurance[]

  @@index([email])
}

// Session store for server-side revocation and security tracking
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// Secure token store for Forgot/Reset Password flows
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

// -------------------------------------------------------------
// 2. Profiles
// -------------------------------------------------------------
model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String?
  lastName    String?
  displayName String?
  avatarUrl   String?
  phoneNumber String?
  timezone    String   @default("UTC")
  country     String?  @default("US")
  region      String?  @default("US")
  currency    String   @default("USD")
  locale      String   @default("en-US")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// -------------------------------------------------------------
// 3. User Settings
// -------------------------------------------------------------
model UserSetting {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme              String   @default("system") // "system" | "light" | "dark"
  emailNotifications Boolean  @default(true)
  pushNotifications  Boolean  @default(true)
  reminderDaysBefore Int      @default(3)
  weeklyDigest       Boolean  @default(true)
  securityAlerts     Boolean  @default(true)

  // Smart Notification & Reminder Engine Settings
  notificationsEnabled Boolean  @default(true)
  notifyCritical       Boolean  @default(true)
  notifyHigh           Boolean  @default(true)
  notifyMedium         Boolean  @default(true)
  notifyLow            Boolean  @default(true)
  notifyReminders      Boolean  @default(true)
  notifyPayments       Boolean  @default(true)
  notifyDocuments      Boolean  @default(true)
  notifyVehicles       Boolean  @default(true)
  notifySubscriptions  Boolean  @default(true)
  notifyImportantDates Boolean  @default(true)
  quietHoursEnabled    Boolean  @default(false)
  quietHoursStart      String   @default("22:00") // 10:00 PM
  quietHoursEnd        String   @default("07:00") // 7:00 AM
  allowCriticalInQuietHours Boolean @default(true)
  soundEnabled         Boolean  @default(true)

  // Customer Onboarding state
  onboardingCompleted  Boolean  @default(false)
  onboardingStep       Int      @default(1)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// -------------------------------------------------------------
// 4. Documents & Document Files (Prepared for Private Storage)
// -------------------------------------------------------------
model Document {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  category       String         // "identity" | "finance" | "vehicle" | "property" | "medical" | "other"
  documentNumber String?
  issuedBy       String?
  issueDate      DateTime?
  expiryDate     DateTime?
  hasExpiry      Boolean        @default(false)
  notes          String?
  tags           String?        // Comma-separated or JSON string
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  files          DocumentFile[]

  @@index([userId])
  @@index([category])
  @@index([expiryDate])
}

model DocumentFile {
  id            String   @id @default(cuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  fileType      String   // MIME type
  fileSize      Int      // File size in bytes
  storageKey    String   // Encrypted storage key / object path
  storageDriver String   @default("local") // "local" | "s3" | "gcs"
  isEncrypted   Boolean  @default(true)
  checksum      String?
  createdAt     DateTime @default(now())

  @@index([documentId])
  @@index([userId])
}

// -------------------------------------------------------------
// 5. Reminders
// -------------------------------------------------------------
model Reminder {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  dueDate        DateTime
  priority       String    @default("medium") // "low" | "medium" | "high" | "urgent"
  status         String    @default("pending") // "pending" | "completed" | "snoozed" | "cancelled"
  category       String    @default("general") // "document" | "payment" | "vehicle" | "personal" | "general"
  relatedType    String?   // "document" | "payment" | "vehicle" | "subscription"
  relatedId      String?
  isRecurring    Boolean   @default(false)
  recurrenceRule String?
  reminderTiming String    @default("exact") // "exact" | "5m" | "15m" | "30m" | "1h" | "1d" | "3d" | "7d" | "30d" | "custom"
  customMinutesBefore Int?
  timezone       String?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([dueDate])
  @@index([status])
  @@index([priority])
}

// -------------------------------------------------------------
// 6. Payments
// -------------------------------------------------------------
model Payment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  payee       String?
  amount      Float
  currency    String    @default("USD")
  dueDate     DateTime
  isPaid      Boolean   @default(false)
  paidAt      DateTime?
  category    String    @default("bill") // "bill" | "loan" | "tax" | "insurance" | "rent" | "other"
  isRecurring Boolean   @default(false)
  frequency   String?   // "weekly" | "monthly" | "quarterly" | "yearly"
  notes       String?
  // Loan / EMI Tracking Fields (Phase 1)
  loanCategory       String?   // "home" | "car" | "personal" | "education" | "business" | "credit_card" | "other"
  bankName           String?
  accountRef         String?   // e.g. last 4 digits of loan/EMI account
  principalAmount    Float?
  interestRate       Float?
  totalTenureMonths  Int?
  paidTenureMonths   Int?      @default(0)
  loanStartDate      DateTime?
  loanClosingDate    DateTime?
  reminderLeadDays   Int?      @default(3)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([dueDate])
  @@index([isPaid])
}

// -------------------------------------------------------------
// 7. Expenses
// -------------------------------------------------------------
model Expense {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  amount        Float
  currency      String   @default("USD")
  category      String   // "housing" | "transport" | "food" | "utilities" | "entertainment" | "health" | "other"
  spentAt       DateTime @default(now())
  paymentMethod String?  // "card" | "cash" | "transfer"
  merchant      String?
  notes         String?
  receiptUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([spentAt])
  @@index([category])
}

// -------------------------------------------------------------
// 8. Budgets
// -------------------------------------------------------------
model Budget {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category       String
  limitAmount    Float
  currency       String    @default("USD")
  period         String    @default("monthly") // "monthly" | "weekly" | "yearly"
  startDate      DateTime?
  endDate        DateTime?
  alertThreshold Int       @default(80)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([category])
}

// -------------------------------------------------------------
// 9. Vehicles
// -------------------------------------------------------------
model Vehicle {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String    // e.g. "Primary Car"
  make               String?
  model              String?
  year               Int?
  licensePlate       String?
  vin                String?
  registrationExpiry DateTime?
  insuranceExpiry    DateTime?
  inspectionExpiry   DateTime?
  nextServiceDate    DateTime?
  // Pollution Certificate (PUC) Fields (Phase 3)
  pucNumber          String?
  pucIssueDate       DateTime?
  pucExpiryDate      DateTime?
  pucNotes           String?
  mileage            Int?
  nextServiceMileage Int?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
}

// -------------------------------------------------------------
// 10. Subscriptions
// -------------------------------------------------------------
model Subscription {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  cost            Float
  currency        String   @default("USD")
  billingCycle    String   @default("monthly") // "monthly" | "yearly" | "weekly" | "quarterly"
  nextBillingDate DateTime
  renewalStatus   String   @default("active")  // "active" | "cancelled" | "paused"
  category        String   @default("entertainment")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId])
  @@index([nextBillingDate])
  @@index([renewalStatus])
}

// -------------------------------------------------------------
// 11. Important Dates
// -------------------------------------------------------------
model ImportantDate {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  eventDate          DateTime
  category           String   @default("personal") // "anniversary" | "birthday" | "legal" | "health" | "career"
  recurrence         String   @default("yearly")   // "none" | "yearly" | "monthly"
  reminderDaysBefore Int      @default(7)
  notes              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([eventDate])
}

// -------------------------------------------------------------
// 12. Family Members
// -------------------------------------------------------------
model FamilyMember {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  relationship     String    // "spouse" | "child" | "parent" | "sibling" | "other"
  birthDate        DateTime?
  bloodType        String?
  emergencyContact Boolean   @default(false)
  phoneNumber      String?
  email            String?
  notes            String?
  healthProfile    HealthProfile?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
}

// -------------------------------------------------------------
// 13. Notifications
// -------------------------------------------------------------
model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  type        String    @default("info") // "info" | "warning" | "alert" | "success"
  priority    String    @default("medium") // "critical" | "high" | "medium" | "low"
  category    String    @default("general") // "reminder" | "document" | "vehicle" | "payment" | "subscription" | "date" | "general"
  linkUrl     String?
  deliveryKey String?   // Unique delivery tracking & duplicate prevention key
  status      String    @default("delivered") // "scheduled" | "processing" | "sent" | "delivered" | "failed" | "read"
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([deliveryKey])
  @@index([priority])
}

// -------------------------------------------------------------
// 13b. Web Push Subscriptions
// -------------------------------------------------------------
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// -------------------------------------------------------------
// 14. Subscription Tiers & Billing Architecture
// -------------------------------------------------------------
model UserSubscription {
  id                     String                @id @default(cuid())
  userId                 String                @unique
  user                   User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                   String                @default("free") // "free" | "premium" | "family"
  planName               String?               @default("Free Starter")
  status                 String                @default("active") // "active" | "past_due" | "cancelled" | "trialing" | "incomplete"
  billingInterval        String                @default("monthly") // "monthly" | "yearly"
  billingCycle           String                @default("monthly") // "monthly" | "yearly"
  amount                 Float                 @default(0.0)
  currency               String                @default("USD")
  provider               String                @default("stripe") // "stripe" | "sandbox"
  providerCustomerId     String?
  providerSubscriptionId String?
  providerPaymentId      String?
  startedAt              DateTime              @default(now())
  currentPeriodStart     DateTime              @default(now())
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean               @default(false)
  cancelledAt            DateTime?
  trialEndsAt            DateTime?
  transactions           BillingTransaction[]
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@index([userId])
  @@index([plan])
  @@index([providerSubscriptionId])
}

// Configurable Plan Catalog (Admin-modifiable without code deployments)
model PlanConfig {
  id                        String   @id @default(cuid())
  plan                      String   @unique // "free" | "premium" | "family"
  name                      String
  description               String?
  monthlyPrice              Float    @default(0.0)
  yearlyPrice               Float    @default(0.0)
  currency                  String   @default("USD")
  maxDocuments              Int      @default(5) // -1 for unlimited
  maxVehicles               Int      @default(1) // -1 for unlimited
  maxFamilyMembers          Int      @default(0) // e.g. 6 for family plan
  allowAdvancedReports      Boolean  @default(false)
  allowExports              Boolean  @default(false)
  allowSubscriptionTracking Boolean  @default(false)
  allowCloudBackup          Boolean  @default(false)
  allowCustomRecurrence     Boolean  @default(false)
  allowAiAssistant          Boolean  @default(false)
  allowMultiDeviceSync      Boolean  @default(false)
  isPopular                 Boolean  @default(false)
  isActive                  Boolean  @default(true)
  updatedAt                 DateTime @updatedAt

  @@index([plan])
}

// -------------------------------------------------------------
// 15. Family Group & Permission Sharing
// -------------------------------------------------------------
model FamilyGroup {
  id        String              @id @default(cuid())
  name      String
  ownerId   String
  owner     User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members   FamilyGroupMember[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([ownerId])
}

model FamilyGroupMember {
  id               String      @id @default(cuid())
  familyGroupId    String
  familyGroup      FamilyGroup @relation(fields: [familyGroupId], references: [id], onDelete: Cascade)
  userId           String?     // Linked user ID if member has an account
  name             String
  email            String?
  role             String      @default("Member") // "Owner" | "Admin" | "Member" | "View Only"
  canViewDocuments Boolean     @default(true)
  canEditDocuments Boolean     @default(false)
  canViewFinance   Boolean     @default(false)
  canEditFinance   Boolean     @default(false)
  canViewVehicles  Boolean     @default(true)
  canEditVehicles  Boolean     @default(false)
  status           String      @default("active") // "active" | "invited" | "pending"
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([familyGroupId])
  @@index([userId])
}

// -------------------------------------------------------------
// 16. Regional Pricing Catalog
// -------------------------------------------------------------
model PlanRegionalPricing {
  id             String   @id @default(cuid())
  plan           String   // "free" | "premium" | "family"
  regionCode     String   // "IN" | "AE" | "US" | "GB" | "EU" | "SA" | "QA" | "KW" | "OM" | "BH"
  country        String
  currency       String
  currencySymbol String
  monthlyPrice   Float    @default(0.0)
  yearlyPrice    Float    @default(0.0)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([plan, regionCode])
  @@index([regionCode])
  @@index([plan])
}

// -------------------------------------------------------------
// 17. Billing & Payment Transactions (Subscription Ledger)
// -------------------------------------------------------------
model BillingTransaction {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  plan            String            // "free" | "premium" | "family"
  amount          Float
  currency        String            @default("USD")
  status          String            @default("paid") // "paid" | "failed" | "pending" | "refunded" | "cancelled"
  paymentProvider String            @default("stripe") // "stripe" | "sandbox"
  transactionId   String            @unique
  billingCycle    String            @default("monthly") // "monthly" | "yearly"
  paymentDate     DateTime          @default(now())
  failureReason   String?
  notes           String?
  receiptUrl      String?           // For customer UTR screenshot or receipt
  utrNumber       String?           // UTR / Transaction reference number
  verifiedBy      String?           // Admin ID who verified manual payment
  verifiedAt      DateTime?         // Timestamp of manual verification
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId])
  @@index([subscriptionId])
  @@index([status])
  @@index([transactionId])
  @@index([paymentDate])
}

// -------------------------------------------------------------
// 18. Centralized System Payment Configuration (Admin Payment Settings)
// -------------------------------------------------------------
model SystemPaymentConfig {
  id              String   @id @default("default_payment_config")
  cardEnabled     Boolean  @default(true)
  stripeEnabled   Boolean  @default(true)
  paypalEnabled   Boolean  @default(false)
  upiEnabled      Boolean  @default(false)
  upiId           String?  // e.g. "smartlifemanager@okaxis"
  upiDisplayName  String?  // e.g. "Smart Life Manager"
  upiQrCodeUrl    String?  // Secure URL or base64 data for UPI QR
  upiInstructions String?  // Instructions for customer UPI transfer
  defaultMethod   String   @default("none") // "none" | "card" | "stripe" | "upi"
  updatedAt       DateTime @updatedAt
}

// -------------------------------------------------------------
// 19. Admin Audit Log (Security & Activity Trail)
// -------------------------------------------------------------
model AdminAuditLog {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  adminEmail String
  action     String   // "admin_login" | "plan_price_change" | "plan_toggled" | "customer_data_cleared" | "subscription_override" | "role_change"
  targetType String?  // "plan" | "user" | "subscription" | "payment" | "system"
  targetId   String?
  details    String?  // JSON string
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 19. AI Assistant (Secure Multi-Tenant Conversation Storage)
// -------------------------------------------------------------
model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @default("New Conversation")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([userId])
  @@index([updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String         // "user" | "assistant" | "system"
  content        String
  tokensUsed     Int?
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

// -------------------------------------------------------------
// 20. Credit Card Management (Phase 4)
// -------------------------------------------------------------
model CreditCard {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardName       String          // e.g. "HDFC Regalia", "Sapphire Preferred"
  bank           String          // e.g. "HDFC Bank", "Chase"
  network        String?         @default("Visa") // "Visa" | "Mastercard" | "Amex" | "RuPay" | "Other"
  lastFour       String          // ONLY last 4 digits stored! Never store full card number or CVV
  creditLimit    Float           // Total credit limit
  currentBalance Float           @default(0.0) // Current billed/unbilled balance
  statementDay   Int             @default(1) // 1-31 (Day of month statement is generated)
  dueDay         Int             @default(20) // 1-31 (Payment due day)
  minimumDue     Float?          @default(0.0)
  totalDue       Float?          @default(0.0)
  currency       String          @default("USD")
  notes          String?
  emis           CreditCardEmi[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([userId])
}

model CreditCardEmi {
  id               String     @id @default(cuid())
  cardId           String
  card             CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant         String     // e.g. "Apple Store", "Amazon"
  totalAmount      Float      // Total purchase price converted to EMI
  monthlyEmi       Float      // Monthly installment amount
  interestRate     Float?     // Annual interest rate percentage
  tenureMonths     Int        // Total tenure in months (e.g. 6, 12, 24)
  paidMonths       Int        @default(0) // Installments paid so far
  startDate        DateTime   // Start date of EMI
  status           String     @default("active") // "active" | "completed" | "cancelled"
  notes            String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([cardId])
  @@index([userId])
}

// -------------------------------------------------------------
// 21. Mutual Funds & Investment Tracking (Phase 5)
// -------------------------------------------------------------
model Investment {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String    // e.g. "Parag Parikh Flexi Cap Fund", "Vanguard 500 ETF"
  fundHouse          String?   // e.g. "PPFAS Mutual Fund", "Vanguard", "BlackRock"
  folioNumber        String?   // Account or Folio number
  type               String    @default("mutual_fund") // "mutual_fund" | "sip" | "stocks" | "fd" | "bonds" | "crypto" | "other"
  investmentMode     String    @default("lumpsum") // "sip" | "lumpsum"
  sipAmount          Float?    // Periodic SIP installment
  sipFrequency       String?   @default("monthly") // "monthly" | "weekly" | "quarterly"
  sipDay             Int?      // Day of month SIP debits (1-31)
  sipStartDate       DateTime?
  sipEndDate         DateTime?
  totalInvested      Float     @default(0.0) // Total principal invested (Cost Basis)
  currentValuation   Float     @default(0.0) // Current portfolio market valuation
  units              Float?    // Total units held
  nav                Float?    // Net Asset Value per unit
  currency           String    @default("USD")
  lastValuationDate  DateTime?
  notes              String?
  status             String    @default("active") // "active" | "paused" | "redeemed"
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([userId])
  @@index([type])
}

// -------------------------------------------------------------
// 22. Family Health Profiles & Health Insurance (Phase 6)
// -------------------------------------------------------------
model HealthProfile {
  id                    String        @id @default(cuid())
  userId                String
  user                  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyMemberId        String?       @unique
  familyMember          FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  memberName            String?       // Fallback name if not linked to familyMember
  bloodGroup            String?       // "A+", "O-", etc.
  height                Float?        // cm
  weight                Float?        // kg
  allergies             String?       // Comma-separated or notes
  chronicConditions     String?       // e.g. "Hypertension, Asthma"
  medications           String?       // Current regular medications
  emergencyContactName  String?
  emergencyContactPhone String?
  doctorName            String?
  doctorPhone           String?
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([userId])
}

model HealthInsurance {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyName        String    // e.g. "Star Comprehensive Family Floater"
  provider          String    // e.g. "Star Health", "BlueCross", "Bupa"
  policyNumber      String    // Policy account / document number
  sumInsured        Float     // Total coverage amount
  premiumAmount     Float     // Premium cost
  premiumFrequency  String    @default("yearly") // "yearly" | "monthly" | "quarterly"
  startDate         DateTime
  expiryDate        DateTime  // Renewal due date
  coveredMembers    String?   // JSON string or comma-separated names of covered members
  tpaContact        String?   // TPA / Helpline phone number
  cashlessHospitals String?   // Notes on preferred hospitals
  notes             String?
  status            String    @default("active") // "active" | "expired" | "grace_period"
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([expiryDate])
}



