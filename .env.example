# ==============================================================
# SMART LIFE MANAGER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# Copy this file to .env or .env.local and populate the values.
# NEVER commit .env or real secret values into version control.

# Database Connection (SQLite for local development, PostgreSQL/MySQL for production)
DATABASE_URL="file:./dev.db"

# Session & JWT Security Secret (Must be at least 32 random characters in production)
# Example generation command: openssl rand -base64 32
JWT_SECRET="your-secure-random-jwt-secret-key-at-least-32-chars"

# Application Metadata & Base URLs
NEXT_PUBLIC_APP_NAME="Smart Life Manager"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Document & File Storage Driver ("local" for local disk, "s3" or "gcs" for cloud)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage/private"

# Stripe Payment & Billing Configuration (Test Mode for development, Live for production)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_MODE="test" # "test" or "live"

# Google OAuth 2.0 Configuration
# Set up OAuth 2.0 Web Client credentials in Google Cloud Console:
# 1. Visit: https://console.cloud.google.com/apis/credentials
# 2. Add Authorized JavaScript origin: http://localhost:3000 (or https://yourdomain.com)
# 3. Add Authorized redirect URI: http://localhost:3000/api/auth/google/callback (or https://yourdomain.com/api/auth/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

