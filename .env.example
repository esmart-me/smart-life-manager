# Environment configuration for Smart Life Manager

# Relational Database URL (SQLite for local dev, PostgreSQL / MySQL for production)
DATABASE_URL="file:./dev.db"

# Session & JWT Security Secret (Use at least 32 characters in production)
JWT_SECRET="smart-life-manager-production-secret-token-key-32-chars-long"

# Application Metadata
NEXT_PUBLIC_APP_NAME="Smart Life Manager"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secure Document Storage Architecture (local | s3 | gcs)
# Phase 1 uses secure local isolation; Phase 2 easily switches to cloud object storage
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./storage/private"
